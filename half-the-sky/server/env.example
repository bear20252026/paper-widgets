# Any OpenAI-compatible chat endpoint works: OpenAI, DeepSeek, Moonshot,
# a local vLLM, Ollama (http://localhost:11434/v1), and so on.
# Leave HTS_API_KEY unset to stay in library mode.
HTS_API_KEY=
HTS_BASE_URL=https://api.openai.com/v1
HTS_MODEL=gpt-4o-mini
HTS_TEMPERATURE=0.7
HTS_MAX_TOKENS=500
# HTS_TIMEOUT=60

# Force library mode even when a key is present:
# HTS_OFFLINE=1

# The page's Turnstile site key is public; the secret is only needed if you
# want the nomination form verified locally as well:
# HTS_TURNSTILE_SECRET=
